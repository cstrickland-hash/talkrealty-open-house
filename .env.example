# Copy to .env for local reminder / monitor tests. Never commit .env.
# Never put these values in the static site config or in chat.

# Apps Script web app URL (the /exec link after deploy)
SIGN_OUT_EXPORT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
APPS_SCRIPT_EXEC_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Must match the Apps Script property EXPORT_SECRET
EXPORT_SECRET=

# Public static site (return links in reminder texts)
SIGN_OUT_PUBLIC_BASE=https://YOUR-SERVICE.onrender.com/open-house-sign-out-sheet
STATIC_URL=https://YOUR-SERVICE.onrender.com/open-house-sign-out-sheet/

# Follow Up Boss (already used by Jarvis). Never print this value.
FUB_API_KEY=

# Monitor (GitHub Actions secrets after go-live)
RENDER_DEPLOY_HOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=cstrickland@pineapplehi.com

# Optional Grok Bot routine webhook (Christopher pastes these himself; never commit or print them).
# On a failed uptime check the monitor POSTs a small JSON body
# ({check, status, time}) with Authorization: Bearer $DOWN_WEBHOOK_KEY.
DOWN_WEBHOOK_URL=
DOWN_WEBHOOK_KEY=
